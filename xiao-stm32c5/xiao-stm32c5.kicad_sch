	(text "STM32C5A max current sunk/sourced by any IO pin is 20mA.\n\nLED I_{f} was set as 10mA and the corresponding V_{f} (from\nthe I-V curves) was used to calculate the resistor values.\n\nThe actual resistor values were rounded up to the nearest common\nvalue."
		(exclude_from_sim no)
		(at 26.416 33.02 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "49e4d09e-645e-4db4-a3bb-09d21065bcf2")
	)
	(text "XIAO STM32C5"
		(exclude_from_sim no)
		(at 23.876 185.42 0)
		(effects
			(font
				(size 2.54 2.54)
				(thickness 0.254)
				(bold yes)
			)
			(justify left)
		)
		(uuid "4ad9e45f-b9a0-4bfa-a99a-6b9125d1946a")
	)
	(text "J2 is a JST SH/GH connector (for connecting an external RX)\nJ3-6 are solder pads (for mounting the RX to the board)\n"
		(exclude_from_sim no)
		(at 182.626 104.394 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "4bad046b-fa54-4196-ba76-924749919b3f")
	)
	(text "The isolation diode is needed for 2 reasons:\n\n1. To drop the ESC voltage (hopefully) below the USB voltage to prevent backfeeding\n2. To prevent the USB from powering the ESC or servos\n\nThe buck converter on the XIAO looks like it can take an input voltage as low as\n3.6V for a 3.3V output, so a ~500mV drop is fine"
		(exclude_from_sim no)
		(at 79.756 105.41 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "4de9ab40-6b1c-43cf-9f04-72c126d39e64")
	)
	(text "Bi-Color Indicator LED"
		(exclude_from_sim no)
		(at 24.384 80.264 0)
		(effects
			(font
				(size 2.54 2.54)
				(thickness 0.254)
				(bold yes)
			)
			(justify left)
		)
		(uuid "6256ccda-e38e-4bba-a396-df1cfcbf7845")
	)
	(text "V_ESC should be max 6V.\n\nThe diode drops ~500mV and the XIAO buck converter\nV_{in} max is 5.5V"
		(exclude_from_sim no)
		(at 181.61 29.718 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "c35fb37d-8724-404a-98b2-6e0480398a0c")
	)
	(text "PWM + Serial Pin Headers"
		(exclude_from_sim no)
		(at 178.562 80.264 0)
		(effects
			(font
				(size 2.54 2.54)
				(thickness 0.254)
				(bold yes)
			)
			(justify left)
		)
		(uuid "ca8389a8-cb6a-4e65-a1d8-1f5115526b0a")
	)
	(text "Serial RX"
		(exclude_from_sim no)
		(at 178.308 154.178 0)
		(effects
			(font
				(size 2.54 2.54)
				(thickness 0.254)
				(bold yes)
			)
			(justify left)
		)
		(uuid "e2694f15-3717-443a-8a15-e5b54bfbd481")
	)
